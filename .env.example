# Test mode only. Configure locally or in hosting secrets; never commit actual values.
STORE_ORIGIN=http://127.0.0.1:4180
PORT=4180
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
DOWNLOAD_SIGNING_SECRET=
# Use durable private storage when deploying the server.
# ORDER_DIRECTORY=/absolute/private/orders
# GAME_ARCHIVE=/absolute/private/last-train-ledger.zip

# Optional test email delivery. No email is sent by the web server itself.
# Run the separate mail worker only with a mailbox you control.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TEST_TO=
